{
  "manifest_version": 3,
  "name": "Visible Recipients Guard",
  "description": "Warns before sending an email to multiple visible recipients (To/Cc) in Gmail (new mail, reply, forward).",
  "version": "0.3.59",
  "default_locale": "en",
  "permissions": ["storage"],
  "host_permissions": ["https://mail.google.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["src/assets/erlix-logo-update.png", "src/assets/bcc-alert-logo.png"],
      "matches": ["https://mail.google.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "src/popup.html"
  }
}
