[Unit]
Description=Erlix Outlook add-in licensing API (Flask)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/erlix/licensing-api
# Must match config.LISTEN_PORT and nginx upstream (127.0.0.1:5003).
Environment=PORT=5003
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/erlix/licensing-api/.venv/bin/python app.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
