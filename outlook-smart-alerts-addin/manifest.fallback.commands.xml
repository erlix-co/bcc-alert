<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides"
  xsi:type="MailApp">
  <Id>40b92946-8f90-45c4-9c56-87226791bb62</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>BCC Alert</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="BCC Alert for Outlook (Fallback Commands)" />
  <Description DefaultValue="Fallback add-in with compose ribbon button while Smart Alerts is pending." />
  <IconUrl DefaultValue="https://erlix.net/bcc-alert/addin/assets/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://erlix.net/bcc-alert/addin/assets/icon-128.png" />
  <SupportUrl DefaultValue="https://erlix.net/bcc-alert/addin/support/" />
  <AppDomains>
    <AppDomain>https://erlix.net</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5" />
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://erlix.net/bcc-alert/addin/src/commands.html" />
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit" />
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
    xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Taskpane.Url" />
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="FallbackGroup">
                <Label resid="FallbackGroup.Label" />
                <Control xsi:type="Button" id="OpenFallbackTaskpaneButton">
                  <Label resid="OpenFallbackTaskpaneButton.Label" />
                  <Supertip>
                    <Title resid="OpenFallbackTaskpaneButton.Label" />
                    <Description resid="OpenFallbackBtnTip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16" />
                    <bt:Image size="32" resid="Icon.32" />
                    <bt:Image size="80" resid="Icon.80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://erlix.net/bcc-alert/addin/assets/icon-64.png" />
        <bt:Image id="Icon.32" DefaultValue="https://erlix.net/bcc-alert/addin/assets/icon-64.png" />
        <bt:Image id="Icon.80" DefaultValue="https://erlix.net/bcc-alert/addin/assets/icon-128.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://erlix.net/bcc-alert/addin/src/commands.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="FallbackGroup.Label" DefaultValue="BCC Alert" />
        <bt:String id="OpenFallbackTaskpaneButton.Label" DefaultValue="BCC Check" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="OpenFallbackBtnTip" DefaultValue="Open BCC Alert panel for a manual recipient visibility check." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
