{
  "name": "outlook-smart-alerts-addin",
  "version": "1.0.0",
  "description": "This project is a separate Outlook implementation of BCC Alert using Office Add-ins Smart Alerts (`OnMessageSend`) instead of DOM interception.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "node --check src/licensing/LicenseManager.js && node --check src/launchevent.js",
    "simulate": "node tools/simulate-smart-alerts.js",
    "hosting:build": "node tools/build-hosting-bundle.js",
    "manifest:build": "node tools/build-manifest.js",
    "manifest:validate": "npx office-addin-manifest validate manifest.production.xml"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1",
    "office-addin-dev-certs": "^2.0.7"
  }
}
